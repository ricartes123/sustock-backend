DATABASE_URL=postgresql://postgres:change_me@localhost:5432/sustock_db
JWT_SECRET=change_me_to_a_long_random_secret

# Comma-separated list of origins allowed to call the API cross-origin.
# Same-origin traffic (Angular dev proxy, Vercel /api rewrite) does not need to be listed.
CORS_ORIGINS=http://localhost:4200

# Set to "production" in Render: marks the session cookie as Secure and blocks the seed.
NODE_ENV=development
PORT=3000
