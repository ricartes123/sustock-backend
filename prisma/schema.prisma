generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  businesses Business[]

  @@index([email])
}

model Business {
  id        String    @id @default(uuid())
  name      String
  currency  String    @default("ARS")
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products  Product[]
  movements Movement[]

  @@index([ownerId])
}

model Product {
  id         String   @id @default(uuid())
  name       String
  price      Decimal  @db.Decimal(10,2)
  stock      Int
  stockMin   Int      @default(5)
  isActive   Boolean  @default(true)
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements  Movement[]

  @@index([businessId])
  @@index([isActive])
}

model Movement {
  id         String        @id @default(uuid())
  type       MovementType
  quantity   Int
  reason     String?
  productId  String
  businessId String
  createdAt  DateTime      @default(now())

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([businessId])
  @@index([createdAt])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}