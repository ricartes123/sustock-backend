generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces      Workspace[]
  teamMemberships TeamMember[]
  movements       Movement[]
  sales           Sale[]

  @@index([email])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("ARS")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  products    Product[]
  movements   Movement[]
  clients     Client[]
  sales       Sale[]

  @@index([ownerId])
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

model TeamMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        Role     @default(STAFF)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  sku         String?
  barcode     String?
  costPrice   Decimal  @default(0) @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  stockMin    Int      @default(5)
  isActive    Boolean  @default(true)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  movements Movement[]
  saleItems SaleItem[]

  @@index([workspaceId])
  @@index([isActive])
}

model Movement {
  id          String       @id @default(uuid())
  type        MovementType
  quantity    Int
  reason      String?
  productId   String
  workspaceId String
  userId      String?
  saleId      String?
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

model Client {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@index([workspaceId])
}

model Sale {
  id          String   @id @default(uuid())
  totalAmount Decimal  @db.Decimal(10, 2)
  clientId    String?
  workspaceId String
  userId      String?
  movements   Movement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([userId])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  unitCost  Decimal @default(0) @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}
